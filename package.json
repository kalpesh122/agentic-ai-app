{
  "name": "agentic-ai-app",
  "version": "0.1.0",
  "description": "Production-grade TypeScript LLM agent application boilerplate: multi-provider (Claude/GPT/Gemini), tool registry, guardrails, pgvector memory, evals, observability, MCP exposure.",
  "license": "MIT",
  "author": "Kalpesh Mali",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "lint": "biome check .",
    "fmt": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "mcp": "node --env-file-if-exists=.env src/mcp/server.ts",
    "eval": "promptfoo eval -c evals/promptfooconfig.yaml",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env src/memory/migrate.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.50",
    "@ai-sdk/google": "4.0.65",
    "@ai-sdk/openai": "4.0.62",
    "@anthropic-ai/sdk": "0.124.0",
    "@hono/node-server": "2.1.1",
    "@langfuse/otel": "5.11.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.222.0",
    "@opentelemetry/sdk-node": "0.222.0",
    "ai": "7.0.94",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.7",
    "pino": "10.3.1",
    "postgres": "3.4.9",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@electric-sql/pglite": "0.5.8",
    "@types/node": "24.13.3",
    "drizzle-kit": "0.31.10",
    "pino-pretty": "13.1.3",
    "promptfoo": "0.122.2",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
