# Copy to .env. Never commit .env.
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# --- Models -----------------------------------------------------------------------------------
# Default model as provider/model-id. Any of: anthropic/claude-opus-5, anthropic/claude-sonnet-5,
# anthropic/claude-haiku-4-5, openai/gpt-5.6-terra, openai/gpt-5.6-sol, google/gemini-3.8-flash,
# google/gemini-3.1-pro-preview. At least one matching provider key must be set.
AI_MODEL=anthropic/claude-sonnet-5
# Embedding model for memory (provider/model-id)
AI_EMBEDDING_MODEL=openai/text-embedding-3-small
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
DEEPSEEK_API_KEY=
# Optional: route every provider through Vercel AI Gateway instead of direct keys
AI_GATEWAY_API_KEY=

# --- Guardrails / cost ---------------------------------------------------------------------------
MAX_INPUT_CHARS=20000
MAX_STEPS=8
# Hard cap per request in USD; the agent stops with a budget error beyond this
MAX_COST_USD=0.50
# Comma-separated tool names the assistant may use
ALLOWED_TOOLS=get_time,search_notes,save_note,http_fetch
# Comma-separated host allowlist for http_fetch
HTTP_FETCH_ALLOWED_HOSTS=example.com,api.github.com

# --- Memory (Postgres + pgvector) --------------------------------------------------------------
# Host port 5436 avoids clashing with a local Postgres on 5432
DATABASE_URL=postgres://app:app@localhost:5436/app
DB_PORT=5436

# --- Observability (optional) -------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://localhost:3001

# --- Council review (optional) ------------------------------------------------------------------
GEMINI_API_KEY=
